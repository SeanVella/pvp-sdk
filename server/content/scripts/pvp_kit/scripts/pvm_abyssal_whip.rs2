// pvp-sdk: the abyssal whip's special attack (Energy Drain) against NPCs, from LostCity's Content
// repository, branch 377-wip (scripts/skill_combat/scripts/player/specs/scripts/pvm_abyssal_whip.rs2),
// MIT licence as server/content/LICENSE. Adapted to 289: the hit is capped by ~npc_max_dealt like
// 289's other specs (377 reads npc_param(max_dealt)), 377's Kurask/Turoth check is gone (no Slayer
// monsters here), and sound_synth keeps 289's loop count of 1.
[label,pvm_abyssal_whip_sa]
~set_sa_vars(oc_param(inv_getobj(worn, ^wearpos_rhand), sa_energy));
def_int $damage = 0;
def_int $maxhit = %com_maxhit;
def_int $damage_capped = 0;
def_int $attack_roll = scale(125, 100, ~player_attack_roll_specific(%damagetype)); // 25% bonus accuracy
def_int $defence_roll = ~npc_defence_roll_specific(^slash_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    $damage = randominc(~npc_max_dealt($maxhit, 0));
    $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
anim(slayer_abyssal_whip_attack, 0);
sound_synth(energydrain, 1, 0);
spotanim_npc(sp_attack_abyssal_whip, 96, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20);
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 1, 20); // delay npc this tick
}
