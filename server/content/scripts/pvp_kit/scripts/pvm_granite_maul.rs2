// pvp-sdk: the granite maul's special attack (Quick Smash) against NPCs, from LostCity's Content
// repository, branch 377-wip (scripts/skill_combat/scripts/player/specs/scripts/pvm_granite_maul.rs2),
// MIT licence as server/content/LICENSE. player_special_attack jumps here before its action-delay
// check, so the smash lands on the next tick instead of waiting for the next attack. Adapted to
// 289 like pvm_abyssal_whip.rs2 (~npc_max_dealt, no Slayer monster check, sound loop count 1).
[label,pvm_granite_maul_sa]
if (npc_stat(hitpoints) = 0) {
    p_stopaction;
    return;
}
%action_delay = add(map_clock, 7);
p_opnpc(2);
~set_sa_vars(oc_param(inv_getobj(worn, ^wearpos_rhand), sa_energy));
def_int $damage = 0;
def_int $maxhit = %com_maxhit;
def_int $damage_capped = 0;
def_int $attack_roll = ~player_attack_roll_specific(%damagetype);
def_int $defence_roll = ~npc_defence_roll_specific(^crush_style);
if (randominc($attack_roll) > randominc($defence_roll)) {
    if (npc_type = count_draynor & inv_total(inv, garlic) > 0) {
        $maxhit = add($maxhit, 1);
    }
    $damage = randominc(~npc_max_dealt($maxhit, 0));
    $damage_capped = min($damage, npc_stat(hitpoints));
    ~give_combat_experience(%damagestyle, $damage_capped, %npc_combat_xp_multiplier);
    npc_heropoints($damage_capped);
}
anim(slayer_granite_maul_special_attack, 0);
sound_synth(quicksmash, 1, 0);
spotanim_pl(sp_attack_maul_spotanim, 96, 0);
~npc_retaliate(0);
npc_queue(2, $damage, 0);
npc_anim(npc_param(defend_anim), 20);
if (npc_param(defend_sound) ! null) {
    sound_synth(npc_param(defend_sound), 1, 20); // delay npc this tick
}
