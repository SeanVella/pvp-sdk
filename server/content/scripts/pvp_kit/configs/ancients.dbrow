// pvp-sdk: Ancient Magicks (pvp_kit/scripts/ancients.rs2). Levels, runes, xp and max hits are OSRS's
// (https://oldschool.runescape.wiki/w/Ancient_Magicks). Death runes are the fourth rune (extrarune),
// which no staff provides; staffs provide the air, fire and water as for the normal spellbook.
// Graphics are 377-wip's (ancients.spotanim). 377 names spotanims 362-367 the other way round from
// OSRS: Ice Burst is 363 (377's ice_blitz_impact), and Ice Blitz is 366 on the caster then 367 on
// the target (377's ice_burst_travel and ice_burst_impact), as RuneLite's GraphicID has them. Smoke
// impacts float at chest height, the rest sit on the ground. Sounds are the waves' (289 has no
// ancient ones): smoke fire, shadow earth, blood wind, ice water.

[magic_spell_smoke_rush]
table=magic_spell_table
data=spell,^smoke_rush
data=spellcom,ancients:smoke_rush
data=name,Smoke Rush
data=members,true
data=levelrequired,50
data=runesrequired,chaosrune,2,firerune,1,airrune,1
data=extrarune,deathrune,2
data=experience,300
data=maxhit,13
data=anim,human_castwave
data=staffanim,human_castwave_staff
data=spotanim_proj,smoke_rush_travel,43,31,51,16,-5,64,10
data=spotanim_target,smoke_rush_impact,100
data=sound_success,fire_wave_all
data=sound_fail,fire_wave_fail
data=continue_by_autocast,false

