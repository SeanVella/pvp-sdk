data=extrarune,deathrune,2
data=experience,300
data=maxhit,13
data=anim,human_castwave
data=staffanim,human_castwave_staff
data=spotanim_proj,smoke_rush_travel,43,31,51,16,-5,64,10
data=spotanim_target,smoke_rush_impact,100
data=sound_success,smoke_rush_impact
data=sound_fail,spellfail
data=continue_by_autocast,false

