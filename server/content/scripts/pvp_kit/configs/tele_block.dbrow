data=runesrequired,lawrune,1,deathrune,1,chaosrune,1
data=experience,800
data=anim,human_castcurse
data=staffanim,human_castcurse_staff
data=spotanim_origin,curse_casting
data=spotanim_proj,curse_travel,43,31,51,16,-5,64,10
data=spotanim_target,tele_block_impact,0
data=sound_success,curse_all
data=continue_by_autocast,false
