// pvp-sdk: the Ancient Magicks spellbook (pvp_kit/scripts/ancients.rs2), generated from
// pvp_kit/configs/ancients.dbrow's spells. Rows are Rush, Burst, Blitz and Barrage; columns are
// Smoke, Shadow, Blood and Ice. Icons are tiles 6-21 of magicon2/magicoff2, and the hover panels
// follow magic.if's.
type=overlay

