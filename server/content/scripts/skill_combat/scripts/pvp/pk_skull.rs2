// requires .active_player and active_player
[proc,deserves_pk_skull]()(boolean)
if (~in_duel_arena(coord) = true) {
    return(false);
}
if (~in_castlewars_game(coord) = true) {
    return(false);
}
if (.%pk_prey1 = uid | .%pk_prey2 = uid | %pk_predator1 = .uid | %pk_predator2 = .uid | %pk_predator3 = .uid) {
    return(false);
}
return(true);

[proc,set_pk_vars]
if (%pvp_protection = ^true) ~pvp_protection_end; // pvp-sdk: attacking ends spawn protection
if (%pvp_newbie = ^true) ~pvp_newbie_end("You have given up your new-player protection by attacking."); // pvp-sdk
if (~deserves_pk_skull = true) {
    ~pk_skull(^pk_skull_duration);
}
// for preys
%pk_prey2 = %pk_prey1;
%pk_prey1 = .uid; 

// for predators
.%pk_predator3 = .%pk_predator2;
.%pk_predator2 = .%pk_predator1;
.%pk_predator1 = uid;

.%lastcombat = map_clock;
.%lastcombat_pvp = map_clock;
.%aggressive_npc = null; // prevents npc's from attacking your opponent after you attack them.
// pvp-sdk: both fighters are teleport locked for ^pvp_teleport_lock ticks
%pvp_combat_clock = map_clock;
.%pvp_combat_clock = map_clock;

// requires active_player
[proc,pk_skull](int $duration)
~headicon_add(^headicon_skull);
%pk_skull = add(map_clock, $duration);
clearsofttimer(pk_skull_timer);
softtimer(pk_skull_timer, $duration);
// pvp-sdk: the guards watch skulled players (pvp_world.rs2)
clearsofttimer(dmm_guard_check);
softtimer(dmm_guard_check, ^dmm_guard_interval);
%pvp_skull_ticks = $duration; // pvp-sdk: the client's skull countdown

[proc,clear_pk_skull]
~headicon_del(^headicon_skull);
clearsofttimer(pk_skull_timer);
%pk_skull = 0;
clearsofttimer(dmm_guard_check); // pvp-sdk
%dmm_guard_hits = 0;
%pvp_skull_ticks = 0; // pvp-sdk

[softtimer,pk_skull_timer]
~clear_pk_skull;

[proc,set_pk_skull_logout]
if (%pk_skull < 1) {
    return;
}
%pk_skull = sub(%pk_skull, map_clock);

[proc,set_pk_skull_login]
if (%pk_skull < 1) {
    return;
}
if (%pk_skull > ^pk_skull_duration) {
    %pk_skull = ^pk_skull_duration;
}
~pk_skull(%pk_skull);
