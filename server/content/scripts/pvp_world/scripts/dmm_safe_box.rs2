// pvp-sdk: the safe deposit box. Ten stacks kept apart from the bank, in the
// dmm_safe_box inv, where a skulled death's bank raid (dmm_bank_keys.rs2) never
// reaches. Any banker opens it from their talk-to options (banker.rs2).

[label,dmm_open_safe_box]
~reorganize_inv(dmm_safe_box);
inv_transmit(inv, dmm_safe_box_side:inv);
inv_transmit(dmm_safe_box, dmm_safe_box:inv);
if_openmain_side(dmm_safe_box, dmm_safe_box_side);

[if_close,dmm_safe_box]
inv_stoptransmit(dmm_safe_box_side:inv);
inv_stoptransmit(dmm_safe_box:inv);

[inv_button1,dmm_safe_box:inv] @dmm_safe_box_withdraw(last_slot, 1);
[inv_button2,dmm_safe_box:inv] @dmm_safe_box_withdraw(last_slot, 5);
[inv_button3,dmm_safe_box:inv] @dmm_safe_box_withdraw(last_slot, 10);
[inv_button4,dmm_safe_box:inv] @dmm_safe_box_withdraw(last_slot, ^max_32bit_int);
[inv_button5,dmm_safe_box:inv] @dmm_safe_box_withdraw(last_slot, null);
[inv_buttond,dmm_safe_box:inv] inv_movetoslot(dmm_safe_box, dmm_safe_box, last_slot, last_targetslot);

[inv_button1,dmm_safe_box_side:inv] @dmm_safe_box_store(last_slot, 1);
[inv_button2,dmm_safe_box_side:inv] @dmm_safe_box_store(last_slot, 5);
[inv_button3,dmm_safe_box_side:inv] @dmm_safe_box_store(last_slot, 10);
[inv_button4,dmm_safe_box_side:inv] @dmm_safe_box_store(last_slot, ^max_32bit_int);
[inv_button5,dmm_safe_box_side:inv] @dmm_safe_box_store(last_slot, null);
[inv_buttond,dmm_safe_box_side:inv] inv_movetoslot(inv, inv, last_slot, last_targetslot);

[label,dmm_safe_box_withdraw](int $slot, int $requested)
def_obj $obj = inv_getobj(dmm_safe_box, $slot);
if ($obj = null) {
    return;
}
if ($requested <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested = last_int;
}
def_int $number = min(inv_total(dmm_safe_box, $obj), $requested);
def_int $overflow = inv_itemspace2(inv, $obj, $number, inv_size(inv));
if ($overflow >= $number) {
    mes("You don't have enough inventory space.");
    return;
}
inv_moveitem(dmm_safe_box, inv, $obj, sub($number, $overflow));

[label,dmm_safe_box_store](int $slot, int $requested)
def_obj $obj = inv_getobj(inv, $slot);
if ($obj = null) {
    return;
}
if (oc_param($obj, unbankable) = ^true) {
    mes("That can't go in your safe deposit box.");
    return;
}
if ($requested <= 0) {
    p_countdialog;
    if (last_int <= 0) return;
    $requested = last_int;
}
def_int $number = min(inv_total(inv, $obj), $requested);
def_int $overflow = inv_itemspace2(dmm_safe_box, $obj, $number, inv_size(dmm_safe_box));
if ($overflow >= $number) {
    mes("Your safe deposit box is full.");
    return;
}
inv_moveitem(inv, dmm_safe_box, $obj, sub($number, $overflow));
