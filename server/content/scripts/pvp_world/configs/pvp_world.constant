// pvp-sdk: the whole world is a combat zone. Outside the Wilderness players can
// fight anyone within this many combat levels of their own; inside it, every
// Wilderness level widens the range by one more, as it always has.
^pvp_combat_range = 15
// Spawn protection after respawning, in ticks (100 = 30s at the 300ms prod tickrate).
// Attacking another player ends it early.
^pvp_protection_duration = 100
// No teleporting for this many ticks after hitting or being hit by a player
// (24 = 7.2s at 300ms, Deadman: Reborn's teleport delay).
^pvp_teleport_lock = 24
// New-player protection: an account made after it was added can't be attacked for its
// first this-many ticks of play (36000 = 3 hours at 300ms). Attacking ends it early.
^pvp_newbie_protection = 36000

// Deadman-style rules (see pvp_world.rs2 and dmm_bank_keys.rs2).
// Guards shoot a skulled player in a safe area every this many ticks
// (2 = 0.6s at 300ms, the once-a-tick pace of Deadman's 600ms world).
^dmm_guard_interval = 2
// Bank keys a player can carry, and the bank stacks a key takes.
^dmm_max_keys = 5
^dmm_key_stacks = 10
// Raise this whenever the safe zones grow: skulls players logged out with under an
// older version are cleared at their next login (~dmm_rules_login).
// 1 = the Deadman rules, which turned the v1 open ground around the towns into
// guarded safe zones.
^dmm_rules_version = 1

// PvP kit: Tele Block stops the target teleporting for this many ticks (1000 = 5 minutes at
// 300ms), half that if they were praying Protect from Magic when it hit.
^pvp_tele_block_ticks = 1000
