// pvp-sdk: breaches (engine/pvp/Breaches.ts). The guardian is spawned by the engine at a
// random multi-combat site every few hours; whoever damages it earns breach points and
// may win a sigil. The warden in Lumbridge trades points for rewards (dmm_breaches.rs2).
[breach_guardian]
size=3
walkanim=demon_walk
readyanim=demon_ready
name=Breach guardian
desc=Something has come through the breach. Everyone nearby wants it dead.
op2=Attack
vislevel=250
model1=model_2942_npc
recol1s=11264
recol1d=930
recol2s=15393
recol2d=930
recol3s=0
recol3d=6073
wanderrange=4
attack=170
defence=190
strength=160
hitpoints=750
huntrange=6
huntmode=aggressive_melee
param=magicdefence,10
param=damagetype,^slash_style
param=attack_anim,demon_attack
param=defend_anim,demon_block
param=death_anim,demon_death
param=attack_sound,demon_attack
param=defend_sound,demon_hit
param=death_sound,demon_death
param=demonbane_vulnerable,yes

[breach_warden]
name=Breach warden
desc=She keeps count of who fought at the breaches, and pays them for it.
walkanim=human_walk_f,human_walk_b,human_walk_l,human_walk_r
readyanim=human_ready
op1=Talk-to
model1=man_head_shorthair
model2=man_torso_platemail
model3=man_arms_platemail
model4=man_hands_gloves
model5=man_legs_platemail
model6=man_feet_icewarriorboots
model7=man_torsoextra_cloak
head1=chat_male_head_shorthair
recol1s=17969
recol1d=930
recol2s=10468
recol2d=6073
recol3s=10570
recol3d=6073
recol4s=15855
recol4d=930
wanderrange=0
