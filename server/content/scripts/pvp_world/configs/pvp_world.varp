// pvp-sdk: 1 while the player has spawn protection. Transmitted so bots can see it.
[pvp_protection]
protect=no
transmit=yes

// map_clock of the player's last PvP hit, dealt or taken (teleport lock).
[pvp_combat_clock]
protect=no

// How many times the guards have shot a skulled player in the current safe area visit.
[dmm_guard_hits]
protect=no

// The ^dmm_rules_version the player last logged in under (~dmm_rules_login).
[dmm_rules_version]
protect=no
scope=perm

// Ticks the skull had left when last written: at every ~pk_skull and about every 50
// ticks after (dmm_guard_check), so a re-skull always changes it. Clients count down
// from the tick it changed (state.skullTicksRemaining).
[pvp_skull_ticks]
protect=no
transmit=yes

// 1 while the player has new-player protection (~pvp_newbie_login). Saved, and
// transmitted so bots can see it.
[pvp_newbie]
protect=no
scope=perm
transmit=yes

// Breach points to spend with the breach warden (dmm_breaches.rs2). Saved, and
// transmitted so bots can see them.
[breach_points]
protect=no
scope=perm
transmit=yes
