// pvp-sdk: sigils (dmm_breaches.rs2). Each gives its perk while carried; two of a kind
// don't stack. They drop from breach guardians, cost breach points, and are lost on death.

[sigil_of_fury]
name=Sigil of fury
desc=While you carry it, your melee hits up to 10% harder. Lost when you die.
cost=1
model=inv_runetalisman_fire
2dxof=2
2dyof=20
2dzoom=1160
2dyan=160
2dxan=352
weight=15g
tradeable=no
param=destroy_death,^true

[sigil_of_stone]
name=Sigil of stone
desc=While you carry it, other players hit you 10% softer. Lost when you die.
cost=1
model=inv_runetalisman_earth
2dxof=2
2dyof=20
2dzoom=1160
2dyan=160
2dxan=352
weight=15g
tradeable=no
param=destroy_death,^true

